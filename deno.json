{
  "imports": {
    "@/": "./src/",
    "@/env": "./src/env.ts",
    "@cliffy/command": "jsr:@cliffy/command@1.2.1",
    "@cliffy/prompt/secret": "jsr:@cliffy/prompt@1.2.1/secret",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/path": "jsr:@std/path@1.1.6"
  },
  "tasks": {
    "agent": "deno run src/cli.ts",
    "guard:compile": "deno compile --no-prompt --allow-sys=uid --allow-read=/var/db/flop-agent-refresh --allow-write=/var/db/flop-agent-refresh/runtime --allow-net=technocore.chat:443 --output=ops/build/flop-agent-refresh src/guarded_refresh.ts",
    "test": "deno test --allow-read=src,tests,docs,deno.json,AGENTS.md,README.md,ops,.agents,.cursor,.claude,.codex,CLAUDE.md,.test-tmp --allow-write=.test-tmp --allow-sys=uid",
    "check": "deno fmt --check && deno lint && deno check src/cli.ts && deno task test",
    "ci": "deno task check"
  },
  "fmt": {
    "exclude": [".agents/skills/technocore-chat/SKILL.md", "src/utils/logger.ts"],
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
